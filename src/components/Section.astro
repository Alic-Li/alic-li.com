---
import { t, pathFor, htmlLang, type Locale } from '../lib/i18n';
import { projectsFor } from '../lib/projects';
import { getCollection } from 'astro:content';
const { lang, page } = Astro.props as {
  lang: Locale;
  page: 'about' | 'blog' | 'projects' | 'publications' | 'lab';
};
const d = t(lang);
const titles = {
  about: d.aboutTitle,
  blog: d.blogTitle,
  projects: d.projectsHeading,
  publications: d.researchHeading,
  lab: d.labHeading,
};
const descriptions = {
  about: d.aboutBody,
  blog: d.blogBody,
  projects: d.emptyProjects,
  publications: d.researchBody,
  lab: d.labIntro,
};
const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<div class="container page-content">
  <header class="page-header">
    <span class="section-label">{d.nav[page]}</span>
    <h1>{titles[page]}</h1>
    <p>{descriptions[page]}</p>
  </header>
  {page === 'about' && (
    <div class="prose">
      <p>{d.aboutSecond}</p>
      <p>{d.aboutResearch}</p>
      <h2>{d.contact}</h2>
      <div class="contact-links">
        <a href="https://github.com/Alic-Li" rel="me">
          GitHub ↗
        </a>
        <a href="https://huggingface.co/Alic-Li" rel="me">
          Hugging Face ↗
        </a>
        <a href="https://www.linkedin.com/in/alic-li" rel="me">
          LinkedIn ↗
        </a>
        <a href="mailto:alic2591709191@gmail.com">Email ↗</a>
      </div>
    </div>
  )}
  {page === 'blog' &&
    posts.map((post) => (
      <a
        class="post-row"
        href={pathFor(lang, `blog/${post.data.translationKey}`)}
      >
        <time datetime={post.data.date.toISOString()}>
          {new Intl.DateTimeFormat(htmlLang(lang), {
            dateStyle: 'medium',
            timeZone: 'UTC',
          }).format(post.data.date)}
        </time>
        <div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  {page === 'projects' &&
    projectsFor(lang).map((project) => (
      <article class="project-block">
        <div>
          <div class="tags">{project.stack}</div>
          <h2>{project.name}</h2>
          <p>{project.description}</p>
        </div>
        <a class="text-link" href={project.url}>
          {d.source} ↗
        </a>
      </article>
    ))}
  {page === 'publications' && (
    <>
      <article class="project-block">
        <div>
          <div class="tags">
            EMNLP 2025 ·{' '}
            {lang === 'en' ? 'Main Conference · Oral' : '主会 · 口头报告'}
          </div>
          <h2>ModRWKV: Transformer Multimodality in Linear Time</h2>
          <p>{d.researchDetail}</p>
          <div class="contact-links">
            <a
              class="text-link"
              href="https://aclanthology.org/2025.emnlp-main.204/"
            >
              {d.paper} ↗
            </a>
            <a class="text-link" href="https://arxiv.org/abs/2505.14505">
              {d.preprint} ↗
            </a>
          </div>
        </div>
      </article>
      <article class="project-block">
        <div>
          <h2>{d.visionTitle}</h2>
          <p>{d.visionBody}</p>
        </div>
      </article>
    </>
  )}
  {page === 'lab' && (
    <article class="workbench">
      <div>
        <span class="section-label">{d.experimental}</span>
        <h2>{d.chatTitle}</h2>
        <p>{d.currentBody}</p>
        <a href={pathFor(lang, 'lab/chat')} class="primary-link">
          {d.playground} ↗
        </a>
      </div>
      <div class="experiment-visual" aria-hidden="true">
        {Array.from({ length: 29 }, (_, i) => (
          <span style={`--bar:${15 + Math.sin(i * 0.6) ** 2 * 65}px`}></span>
        ))}
      </div>
    </article>
  )}
</div>
