---
import { t, pathFor, htmlLang, type Locale } from '../lib/i18n';
import { getCollection } from 'astro:content';
const { lang, page } = Astro.props as {
  lang: Locale;
  page: 'about' | 'blog' | 'projects' | 'publications' | 'lab';
};
const d = t(lang);
const titles = {
  about: d.aboutTitle,
  blog: d.blogTitle,
  projects: d.projectsHeading,
  publications: d.researchHeading,
  lab: d.labHeading,
};
const descriptions = {
  about: d.aboutBody,
  blog: d.blogBody,
  projects: d.emptyProjects,
  publications: d.researchBody,
  lab: d.labIntro,
};
const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<div class="container page-content">
  <header class="page-header">
    <span class="section-label">{d.nav[page]}</span>
    <h1>{titles[page]}</h1>
    <p>{descriptions[page]}</p>
  </header>
  {page === 'about' && (
    <div class="prose">
      <p>{d.aboutSecond}</p>
      <a href="https://github.com/Alic-Li">GitHub ↗</a>
    </div>
  )}
  {page === 'blog' &&
    posts.map((post) => (
      <a
        class="post-row"
        href={pathFor(lang, `blog/${post.data.translationKey}`)}
      >
        <time datetime={post.data.date.toISOString()}>
          {new Intl.DateTimeFormat(htmlLang(lang), {
            dateStyle: 'medium',
            timeZone: 'UTC',
          }).format(post.data.date)}
        </time>
        <div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  {page === 'projects' && (
    <article class="project-block">
      <div>
        <div class="tags">
          <span>ASTRO</span>
          <span>REACT</span>
          <span>CLOUDFLARE</span>
        </div>
        <h2>{d.siteProject}</h2>
        <p>{d.siteProjectBody}</p>
      </div>
      <a class="text-link" href="https://github.com/Alic-Li/alic-li.com">
        {d.source} ↗
      </a>
    </article>
  )}
  {page === 'publications' && (
    <div class="empty-state">{d.emptyPublications}</div>
  )}
  {page === 'lab' && (
    <article class="workbench">
      <div>
        <span class="section-label">{d.experimental}</span>
        <h2>{d.chatTitle}</h2>
        <p>{d.currentBody}</p>
        <a href={pathFor(lang, 'lab/chat')} class="primary-link">
          {d.playground} ↗
        </a>
      </div>
      <div class="experiment-visual" aria-hidden="true">
        {Array.from({ length: 29 }, (_, i) => (
          <span style={`--bar:${15 + Math.sin(i * 0.6) ** 2 * 65}px`}></span>
        ))}
      </div>
    </article>
  )}
</div>
