---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/jetbrains-mono';
import GlassSegments from '../components/GlassSegments';
import Preferences from '../components/Preferences';
import { t, htmlLang, pathFor, type Locale } from '../lib/i18n';
interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  path?: string;
  alternatePath?: string;
}
const {
  lang,
  title,
  description,
  path = '',
  alternatePath = path,
} = Astro.props;
const d = t(lang);
const alternate = pathFor(lang === 'en' ? 'zh' : 'en', alternatePath);
const canonical = new URL(pathFor(lang, path), Astro.site);
const nav = [
  'home',
  'about',
  'blog',
  'projects',
  'publications',
  'lab',
] as const;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="UTF-8" />
    <ClientRouter fallback="swap" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — Alic Li` : 'Alic Li — ' + d.hero + ' ' + d.heroAccent}</title>
    <meta name="description" content={description || d.description} />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/favicon.svg?v=20261019-raven"
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang(lang)} href={canonical} />
    <link
      rel="alternate"
      hreflang={lang === 'en' ? 'zh-CN' : 'en'}
      href={new URL(alternate, Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        new URL(lang === 'en' ? pathFor('en', path) : alternate, Astro.site)
      }
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={d.nav.blog}
      href={pathFor(lang, 'rss.xml')}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title || 'Alic Li'} />
    <meta property="og:description" content={description || d.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <script is:inline>
      (() => {
        const media = matchMedia('(prefers-color-scheme: dark)');
        let preference = 'system';
        try {
          const stored = localStorage.getItem('appearance');
          if (['light', 'dark'].includes(stored)) preference = stored;
        } catch {}
        const apply = () => {
          document.documentElement.dataset.theme =
            preference === 'system'
              ? media.matches
                ? 'dark'
                : 'light'
              : preference;
        };
        apply();
        media.addEventListener('change', apply);
        window.addEventListener('appearance-change', (event) => {
          preference = event.detail;
          apply();
        });
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      {d.skip}
    </a>
    <header
      class="header-wrap"
      transition:name="site-navigation"
      transition:animate="none"
    >
      <div class="nav-shell">
        <a
          class="wordmark glass nav-wordmark"
          href={pathFor(lang)}
          aria-label={`Alic Li's Blog — ${d.nav.home}`}
        >
          Alic Li's Blog
        </a>
        <GlassSegments
          items={nav.map((key) => ({
            key,
            label: d.nav[key],
            href: pathFor(lang, key === 'home' ? '' : key),
          }))}
          transition:persist="navigation"
          selected={path.split('/')[0] || 'home'}
          label={d.menu}
          client:load
        />
        <Preferences
          transition:persist="preferences"
          lang={lang}
          alternate={alternate}
          path={path === '404' ? '' : path}
          client:load
        />
      </div>
    </header>
    <main id="main" transition:name="workspace" transition:animate="none">
      <slot />
    </main>
    <footer
      class="site-footer"
      transition:name="site-footer"
      transition:animate="none"
    >
      <a href={pathFor(lang)} class="wordmark">
        Alic Li's Blog
      </a>
      <p>{d.footer}</p>
      <div>
        <a href="https://github.com/Alic-Li" rel="me">
          GitHub ↗
        </a>
        <a href={pathFor(lang, 'rss.xml')}>RSS ↗</a>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
    <script>
      import { slideDirection } from '../lib/navigation';
      document.addEventListener('astro:before-preparation', (event) => {
        document.documentElement.dataset.slide = slideDirection(
          event.from,
          event.to,
          event.direction,
        );
      });
      document.addEventListener('astro:before-swap', (event) => {
        // Apply the existing theme before the new document is painted.
        event.newDocument.documentElement.dataset.theme =
          document.documentElement.dataset.theme;
        event.newDocument.documentElement.dataset.slide =
          document.documentElement.dataset.slide;
      });
    </script>
  </body>
</html>
